# ---------------------------------------------------------------------
# Meet X — variables d'environnement
# Copier en .env.local pour le développement. Ne jamais committer .env.local.
# Sans les deux premières variables, l'app démarre en « mode démo » :
# profils fictifs, écritures désactivées.
# ---------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : serveur uniquement (webhooks, cron, URL signées des photos).
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Vérification d'identité (point 7 du brief : prestataire à trancher) ---
# mock | veriff | onfido | idnow — « mock » ne vaut PAS vérification.
IDENTITY_PROVIDER=mock
IDENTITY_API_KEY=
IDENTITY_WEBHOOK_SECRET=

# --- Modération photo (pré-filtre avant revue humaine) ---
# mock | sightengine | rekognition
MODERATION_PROVIDER=mock
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# --- E-mails transactionnels ---
RESEND_API_KEY=

# --- Repli si pg_cron n'est pas activé : POST /api/cron avec cet en-tête ---
CRON_SECRET=
